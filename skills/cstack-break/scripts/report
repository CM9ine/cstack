#!/usr/bin/env python3
"""report: turn a cstack-break record into the PR section, or check that it is complete.

  report [pr]        print the "Break loop" PR section (between cstack-break markers)
  report check       exit 1 and list problems if the record is not ready for a PR
  report dir         print the state directory for the current branch

  --state DIR        use this state directory instead of the current branch's

The record lives in <git dir>/cstack/<branch>/ (see record.md next to SKILL.md):
rounds.tsv and findings.tsv, both tab-separated with a header row.
"""

from __future__ import annotations

import csv
import subprocess
import sys
from collections import Counter, defaultdict
from pathlib import Path

PROVEN = {"fixed", "closed", "open"}  # blockers and shoulds that reproduced
LIVE = {"fixed", "open"}  # reproduced and judged real
START = "<!-- cstack-break:start -->"
END = "<!-- cstack-break:end -->"
MIN_GROWTH_LINES = 30  # below this, growth is noise, such as a few added tests


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout.strip()


def state_dir() -> Path:
    branch = git("branch", "--show-current").replace("/", "-") or "detached"
    return Path(git("rev-parse", "--absolute-git-dir")) / "cstack" / branch


def read_tsv(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []
    with path.open(newline="") as f:
        return [
            {k: (v or "").strip() for k, v in row.items()}
            for row in csv.DictReader(f, delimiter="\t", quoting=csv.QUOTE_NONE)
        ]


def load(state: Path) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
    rounds = read_tsv(state / "rounds.tsv")
    findings = read_tsv(state / "findings.tsv")
    return rounds, findings


def size(r: dict[str, str]) -> int:
    try:
        return int(r.get("added") or 0) + int(r.get("removed") or 0)
    except ValueError:
        return 0


def flags(rounds: list[dict[str, str]], findings: list[dict[str, str]]) -> list[str]:
    out: list[str] = []
    reopened = Counter(f["reopens"] for f in findings if f.get("reopens"))
    for fid, n in sorted(reopened.items()):
        out.append(f"{fid} came back after its fix ({n}x)")
    live_by_round = Counter(
        f["round"] for f in findings if f["severity"] in ("blocker", "should") and f["status"] in LIVE
    )
    loop = [r["round"] for r in rounds if r.get("kind") in ("loop", "post-pr-full")]
    for i in range(len(loop) - 2):
        a, b, c = (live_by_round.get(x, 0) for x in loop[i : i + 3])
        if a and not (b < a or c < b):
            out.append(f"proven findings did not drop over rounds {loop[i]}-{loop[i + 2]} ({a}, {b}, {c})")
            break
    if len(rounds) > 1 and size(rounds[0]):
        grown = size(rounds[-1]) - size(rounds[0])
        growth = grown / size(rounds[0])
        if growth >= 0.5 and grown >= MIN_GROWTH_LINES:
            out.append(f"diff grew {growth:.0%} (+{grown} lines) since round {rounds[0]['round']}")
    return out


def outcome(f: dict[str, str]) -> str:
    s, commit, note = f["status"], f.get("commit", ""), f.get("note", "")
    arb = f.get("arbiter", "")
    text = {
        "fixed": f"**Fixed** in {commit}" if commit else "**Fixed**",
        "removed": f"**Removed** in {commit}" if commit else "**Removed**",
        "closed": "**Closed** by arbiter",
        "dropped": "**Dropped**: did not reproduce",
        "filtered": "**Filtered** as a repeat",
        "kept": "**Kept**",
        "noted": "**Noted**",
        "escalated": "**Escalated**: could not be reproduced, needs a human look",
        "open": "**Open**",
    }.get(s, f"**{s}**")
    if arb == "finding-upheld":
        text = "Disputed, arbiter upheld the finding. " + text
    elif arb == "dispute-upheld":
        text = "Disputed. " + text
    if not note:
        return text
    return f"{text}. {note[0].upper()}{note[1:]}"


def pr_section(rounds: list[dict[str, str]], findings: list[dict[str, str]]) -> str:
    by_round: dict[str, list[dict[str, str]]] = defaultdict(list)
    for f in findings:
        by_round[f["round"]].append(f)
    ran = {a.strip() for r in rounds for a in r.get("adversaries", "").split(",") if a.strip()}
    adversaries = sorted(ran or {a for f in findings for a in f.get("by", "").split("+") if a})
    arbiter_calls = sum(1 for f in findings if f.get("arbiter"))
    lines = [START, "## Break loop", ""]
    lines.append(
        f"Rounds: {len(rounds)} · Adversaries: {', '.join(adversaries) or 'none reported'}"
        f" · Arbiter calls: {arbiter_calls}"
    )
    lines += [
        "",
        "| Round | Kind | Blockers | Shoulds | Nits | Overbuild | Concerns | Dropped | Disputed | Filtered | Diff |",
        "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    for r in rounds:
        fs = by_round.get(r["round"], [])
        count = lambda pred: sum(1 for f in fs if pred(f))  # noqa: E731
        lines.append(
            "| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | +{} −{} |".format(
                r["round"],
                r.get("kind", "loop"),
                count(lambda f: f["severity"] == "blocker" and f["status"] in PROVEN),
                count(lambda f: f["severity"] == "should" and f["status"] in PROVEN),
                count(lambda f: f["severity"] == "nit" and f["status"] != "dropped"),
                count(lambda f: f["severity"] == "overbuild"),
                count(lambda f: f["severity"] == "concern"),
                count(lambda f: f["status"] == "dropped"),
                count(lambda f: bool(f.get("arbiter"))),
                count(lambda f: f["status"] == "filtered"),
                r.get("added") or 0,
                r.get("removed") or 0,
            )
        )
    fl = flags(rounds, findings)
    lines += ["", "Flags: " + ("; ".join(fl) if fl else "none")]
    escalated = [f for f in findings if f["status"] == "escalated"]
    if escalated:
        lines += ["", "**Escalated concerns (need a human look):**"]
        lines += [f"- {f['id']} [{f['by']}] `{f['location']}` {f['claim']}" for f in escalated]
    lines += ["", "<details><summary>Findings by round</summary>", ""]
    for r in rounds:
        fs = by_round.get(r["round"], [])
        title = f"**Round {r['round']}** ({r.get('kind', 'loop')}, `{r.get('head', '')[:7]}`)"
        lines.append(title + (": no findings" if not fs else ""))
        for f in fs:
            repro = f" Repro: `{f['repro']}`." if f.get("repro") else ""
            lines.append(
                f"- {f['id']} [{f['severity']}, {f['by']}] `{f['location']}` {f['claim'].rstrip('.')}.{repro} {outcome(f)}"
            )
        lines.append("")
    lines += ["</details>", END]
    return "\n".join(lines)


def check(rounds: list[dict[str, str]], findings: list[dict[str, str]]) -> list[str]:
    problems: list[str] = []
    if not rounds:
        problems.append("rounds.tsv is missing or empty")
    for f in findings:
        fid = f.get("id", "?")
        if f["status"] == "open":
            problems.append(f"{fid} is still open")
        if f["status"] in ("fixed", "removed") and not f.get("commit") and f["severity"] != "nit":
            problems.append(f"{fid} is {f['status']} but has no commit")
        if f["status"] == "kept" and not f.get("note"):
            problems.append(f"{fid} was kept without a reason in note")
        if f["status"] == "closed" and f.get("arbiter") != "dispute-upheld":
            problems.append(f"{fid} is closed without an arbiter ruling")
    if rounds:
        last = rounds[-1]["round"]
        live = [
            f["id"]
            for f in findings
            if f["round"] == last and f["severity"] in ("blocker", "should") and f["status"] in LIVE
        ]
        if live and rounds[-1].get("kind") != "post-pr-small":
            problems.append(f"last round {last} still had live findings ({', '.join(live)}): run another round")
    return problems


def notes(rounds: list[dict[str, str]]) -> list[str]:
    if not rounds or not rounds[-1].get("head"):
        return []
    reviewed = rounds[-1]["head"]
    changed = git("diff", "--stat", reviewed, "HEAD")
    if not changed:
        return []
    return [
        f"note: HEAD differs from the last reviewed head {reviewed[:7]}. That is fine only for "
        "non-behavior commits (comments, docs, nit renames) or a rebase with an identical patch. "
        "Anything else needs another round."
    ]


def main(argv: list[str]) -> int:
    state = None
    if "--state" in argv:
        i = argv.index("--state")
        state = Path(argv[i + 1])
        del argv[i : i + 2]
    cmd = argv[0] if argv else "pr"
    if cmd == "dir":
        print(state_dir())
        return 0
    rounds, findings = load(state or state_dir())
    if cmd == "pr":
        print(pr_section(rounds, findings))
        return 0
    if cmd == "check":
        problems = check(rounds, findings)
        for p in problems + notes(rounds):
            print(p)
        if not problems:
            print("record complete")
        return 1 if problems else 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
